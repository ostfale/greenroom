# Copy to .env beside compose.pi.yaml on the Pi and fill in. The .env itself is ignored by
# git — none of this belongs in the repository.

# The database. Anything, as long as it is not the word below.
POSTGRES_PASSWORD=change-me

# The image to run. Another group builds its own and points this at it.
GREENROOM_IMAGE=ghcr.io/ostfale/greenroom:latest

# Mail. Leave the host empty and nothing is sent: the draft is written to the log instead.
# The address is the one every inquiry is sent from, replied to and blind-copied to.
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
GREENROOM_MAIL_FROM=

# Copy to .env beside compose.pi.yaml on the Pi and fill in. The .env itself is ignored by
# git — none of this belongs in the repository.

# Which compose files belong to this installation. Compose reads it from here, so the
# commands are `docker compose pull` and `docker compose up -d` with no -f to forget.
# Name only the first file where the graphs are not wanted.
COMPOSE_FILE=compose.pi.yaml:compose.observability.yaml

# The database. Anything, as long as it is not the word below.
POSTGRES_PASSWORD=change-me

# The image to run. Another group builds its own and points this at it.
GREENROOM_IMAGE=ghcr.io/ostfale/greenroom:latest

# Looking up where an address is, for the little map on a location page. Off by default.
# OpenStreetMap needs no key but asks who is calling — a contact address is the custom.
GREENROOM_GEO_ENABLED=false
GREENROOM_GEO_USER_AGENT=greenroom (info@example.org)

# Grafana, where compose.observability.yaml runs along. The user is `admin`. It is the
# only login in the stack — Prometheus and the node exporter answer whoever asks, which is
# the same home-network trust the application itself is built on.
GRAFANA_ADMIN_PASSWORD=change-me-too
